{
  "_note": "Two 1920x1080 monitors side by side, each output fullscreen on its own monitor (3840x1080 canvas). The engine logs 'monitor N: ...' at startup; set 'monitor' below to match. If the screens come out swapped, swap the two monitor numbers.",

  "canvas": { "width": 3840, "height": 1080, "background": [0.02, 0.02, 0.03, 1.0] },
  "playback": { "autoplay": true, "loop": true, "duration": 10.0 },

  "outputs": [
    {
      "id": "left-monitor",
      "canvas_rect": { "x": 0, "y": 0, "w": 1920, "h": 1080 },
      "window": { "fullscreen": true, "monitor": 0 }
    },
    {
      "id": "right-monitor",
      "canvas_rect": { "x": 1920, "y": 0, "w": 1920, "h": 1080 },
      "window": { "fullscreen": true, "monitor": 1 }
    }
  ],

  "layers": [
    {
      "id": "grid-left",
      "source": { "type": "image", "path": "media/grid-1920x1080.png" },
      "transform": { "position": [960, 540], "size": [1920, 1080], "z": 0 }
    },
    {
      "id": "grid-right",
      "source": { "type": "image", "path": "media/grid-1920x1080.png" },
      "transform": { "position": [2880, 540], "size": [1920, 1080], "z": 0 }
    },
    {
      "id": "banner-across-both",
      "source": { "type": "color", "rgba": [0.10, 0.65, 0.62, 1.0] },
      "transform": { "position": [1920, 300], "size": [3000, 180], "opacity": 0.85, "z": 1 }
    },
    {
      "id": "rotated-box-on-seam",
      "source": { "type": "color", "rgba": [0.95, 0.55, 0.15, 1.0] },
      "transform": { "position": [1920, 760], "size": [420, 420], "rotation": 30, "z": 2 }
    }
  ]
}
